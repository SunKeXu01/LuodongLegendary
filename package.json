{
  "name": "luodong-legendary",
  "version": "0.3.0",
  "private": true,
  "description": "《泺栋传奇》明朝武侠 Windows 单机游戏",
  "author": "SunKeXu01",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:dir": "pnpm build && electron-builder --dir",
    "desktop:win": "pnpm build && electron-builder --win portable --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.1.0",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.2.5",
    "vitest": "^3.2.4",
    "wait-on": "9.1.0"
  },
  "packageManager": "pnpm@10.13.1",
  "build": {
    "appId": "com.sunkexu.luodonglegendary",
    "productName": "泺栋传奇",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LuodongLegendary-${version}-win-${arch}.${ext}"
    }
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
